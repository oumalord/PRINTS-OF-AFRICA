# Copy this file to .env and fill in your real Neon connection string.
# Get this value from the Neon console: Project -> Connect -> Connection string.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require

# Port the Express API listens on
PORT=3000

# Comma-separated list of origins allowed to call this API (your site's domain)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
